KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=logs-topic
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PATTERN=logstash-*
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash # e.g. gpt-4o, claude-3-5-sonnet-20240620, gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key_if_using_anthropic_for_embeddings
GITHUB_TOKEN=your_github_token
GITHUB_REPO_URLS=https://github.com/your-org/service1,https://github.com/your-org/service2
SLACK_WEBHOOK_URL=

# --- SMTP Email Notifier (Optional fallback) ---
# If SLACK_WEBHOOK_URL is not set, alerts will fall back to email if SMTP_SERVER is configured.
# If both are configured, alerts will be sent to both channels.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
# You can provide multiple receiver emails by separating them with commas
ALERT_TO_EMAIL=oncall_team@yourcompany.com,dev_team@yourcompany.com

DEDUP_WINDOW_MINUTES=15
MAGIC_LINK_EXPIRY_HOURS=48
CHAT_UI_BASE_URL=http://localhost:3001/chat
JWT_SECRET=super_secret_local_dev_key
